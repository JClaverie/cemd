        $improper:i4      @improper:g1     $atom:N1     $atom:C6     $atom:C7     $atom:C4     
        $improper:i5      @improper:g1     $atom:C5     $atom:N2     $atom:H10    $atom:N4     
        $improper:i6      @improper:g1     $atom:C6     $atom:O2     $atom:N1     $atom:N3     
        $improper:i7      @improper:g1     $atom:N3     $atom:C6     $atom:C1     $atom:C2     
        $improper:i8      @improper:g1     $atom:N4     $atom:C3     $atom:C5     $atom:C8     
    }
}
